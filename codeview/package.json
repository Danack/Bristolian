{
  "name": "bristolian-codeview-ui",
  "version": "1.0.0",
  "description": "CodeView webview UI (Preact). Webpack cwd is codeview/. Scripts match app/ names for the js_builder container.",
  "private": true,
  "scripts": {
    "js:build:dev": "webpack --mode development",
    "js:build:dev:watch": "webpack --watch --mode development",
    "js:build:prod": "webpack --mode production",
    "sass:build:dev": "sass public/scss/codeview.scss public/css/codeview.bundle.css",
    "sass:build:prod": "sass public/scss/codeview.scss public/css/codeview.bundle.css --style=compressed",
    "sass:build:watch": "sass public/scss/codeview.scss public/css/codeview.bundle.css --watch"
  },
  "license": "MIT",
  "dependencies": {
    "preact": "^10.11.3"
  },
  "devDependencies": {
    "@types/node": "^18.11.9",
    "sass": "1.77.8",
    "source-map-loader": "^4.0.1",
    "ts-loader": "^9.4.1",
    "typescript": "^4.9.3",
    "webpack": "^5.75.0",
    "webpack-cli": "^5.0.0"
  }
}
