{
    "name": "danack/bristolian",
    "type": "project",

  "repositories": [
    {
      "type": "vcs",
      "url": "https://github.com/jasonmccreary/phpunit-tia"
    }
  ],

    "require": {
        "amphp/amp": "v3.1.3",
        "amphp/http-client": "v5.3.6",
        "amphp/http-server": "v3.4.6",
        "amphp/http-server-router": "v2.0.0",
        "amphp/http-server-static-content": "v2.0.0",
        "amphp/log": "v2.0.0",
        "amphp/mysql": "v3.1.1",
        "amphp/redis": "v2.0.4",
        "amphp/socket": "v2.4.1",
        "amphp/websocket-server": "v4.0.0",
        "danack/configurator": "1.1.1",
        "danack/console": "v2.7.2",
        "danack/esprintf": "2.1.0",
        "danack/injector": "0.9.0",
        "danack/looping-exec": "0.3.0",
        "danack/json-safe": "0.1.1",
        "danack/slim-dispatcher": "dev-dev",
        "danack/datatype": "0.10.0",
        "hashids/hashids": "5.0.2",
        "ext-redis": "*",
        "justinrainbow/json-schema": "5.3.4",
        "laminas/laminas-diactoros":"3.8.0",
        "ramsey/uuid": "4.9.4",
        "predis/predis": "v2.4.1",
        "seld/jsonlint": "1.12.1",
        "slim/slim": "4.10.0",
        "tholu/php-cidr-match": "0.2",
        "ext-json": "*",
        "ext-curl": "*",
        "michelf/php-markdown": "1.9.1",
        "monolog/monolog": "3.12.0",
        "thecodingmachine/safe": "v3.4.0",
        "league/commonmark": "2.10.1",
        "ext-posix": "*",
        "spatie/yaml-front-matter": "2.1.1",
        "ext-pdo": "*",
        "chillerlan/php-qrcode": "4.4.2",
        "minishlink/web-push": "v8.0.0",
        "league/flysystem": "3.36.0",
        "league/flysystem-aws-s3-v3": "3.35.3",
        "sendgrid/sendgrid": "8.1.2",
        "mailgun/mailgun-php": "v4.5.2",
        "symfony/http-client": "v7.4.19",
        "nyholm/psr7": "1.8.2",
        "ext-xmlreader": "*",
        "psr/http-server-middleware": "1.0.2",
        "php" : "^8.2",
        "ircmaxell/random-lib": "v1.2.0",
        "ext-openssl": "*",
        "ext-mbstring": "*",
        "ext-exif": "*",
        "ext-libxml": "*",
        "ext-dom": "*",
        "ext-pcntl": "*"
    },
    "require-dev": {
        "behat/behat": "v3.33.0",
        "friends-of-behat/mink-extension": "v2.7.5",
        "danack/coding-standard": "0.4.0",
        "danack/php-unit-helper": "0.5.0",
        "dmore/behat-chrome-extension": "1.4.1",
        "dmore/chrome-mink-driver": "2.10.0",
        "phpunit/phpunit": "13.3.2",
        "phpstan/phpstan": "2.2.2",
        "phpstan/phpstan-strict-rules": "2.0.12",
        "qossmic/deptrac-shim": "1.0.2",
        "slevomat/coding-standard": "7.2.1",
        "squizlabs/php_codesniffer": "3.13.6",
        "yoast/yoastcs": "1.0",
        "genesis/behat-fail-aid": "3.7.5",
        "brianium/paratest": "v7.24.1",
        "nicksdot/phpstan-phpstorm-error-identifiers": "0.3.1",
        "jasonmccreary/phpunit-tia": "dev-main#35d560bb382af12bb8ce8e42c4e7ef8ae858c0a4",
      "thecodingmachine/phpstan-safe-rule": "v1.4.7"
    },
    "autoload": {
        "psr-0": {
            "Asm\\": "asm_in_project/lib/",
            "Bristolian\\": "src/",
            "BristolianBehat\\": "src/",
            "BristolianChat\\": "src/",
            "BristolianGenerated\\": "src/",
            "Key\\": "src/",
            "OpenApi\\": "src/",
            "UrlFetcher\\": "src/"
        },
        "psr-4": {
            "BristolianGenerated\\Database\\": "src/BristolianGenerated/Database"
        },
        "files": [
            "src/functions.php",
            "src/functions_searching.php",
            "src/functions_common.php",
            "src/functions_exif.php",
            "src/functions_tinned_fish.php",
            "src/functions_whatdotheyknow.php",
            "src/functions_supervisord.php"
        ]
    },
    "autoload-dev": {
        "psr-0": {
            "BristolianChatTest\\": "test/",
            "BristolianTest\\": "test/",
            "IntegrationTest\\": "test/"
        }
    },
    "config": {
        "platform-check": false,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": false,
            "php-http/discovery": false
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
